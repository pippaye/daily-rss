# ==============================================================================
# Miniflux 配置
# ==============================================================================
MINIFLUX_BASE_URL=https://miniflux.example.com
MINIFLUX_API_KEY=your_miniflux_api_token
# 抓取近多少天的条目（默认 3 天）
MINIFLUX_DAYS_LIMIT=3
# 条目状态过滤：留空拉取全部（通过本地 SQLite 区分是否已读），或设为 unread
# MINIFLUX_STATUS=unread

# --- 分组（Categories）控制与配额保护 ---
# 单个分类最多精选的条目上限（防止某篇论文源一次性爆发几百篇挤占其他分类，默认 15）
MINIFLUX_MAX_PER_CATEGORY=15
# 仅包含的分组（以逗号隔开，留空则包含全部）：
# MINIFLUX_INCLUDE_CATEGORIES=00-Core&Frontier,10-PostTraining,20-EngineeringReleases
# 排除的分组（以逗号隔开）：
# MINIFLUX_EXCLUDE_CATEGORIES=50-Community&Buzz

# ==============================================================================
# LLM 生成配置 (兼容 OpenAI 接口规范)
# ==============================================================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_API_KEY=sk-your-openai-or-compatible-key
# 单次日报纳入的最大条目数上限（防止超出模型上下文）
LLM_MAX_ENTRIES=60
# 单篇文章正文最大截断字数
LLM_MAX_CONTENT_CHARS=1500

# ==============================================================================
# 邮件推送配置 (SMTP)
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_email_smtp_password_or_auth_code
# 是否使用 SSL 加密（端口 465 一般为 true；端口 587 一般为 false 并开启 TLS）
SMTP_USE_SSL=true
SMTP_USE_TLS=false
# 收件人邮箱（多个用逗号隔开）
EMAIL_TO=recipient@example.com
# 发件人显示信息（可选）
EMAIL_FROM_NAME="Daily RSS Bot"
EMAIL_SUBJECT_PREFIX="[每日 RSS 简报]"

# ==============================================================================
# 调度与时区
# ==============================================================================
# 标准 Cron 表达式（分 时 日 月 周），例如每天早晨 8:00 执行: "0 8 * * *"
ON_SCHEDULE="0 8 * * *"
TZ=Asia/Shanghai

# ==============================================================================
# 数据与报表目录（可选）
# ==============================================================================
# DATA_DIR=./data
# REPORTS_DIR=./reports
